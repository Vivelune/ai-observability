# Copy to .env (never commit .env)
KAFKA_BROKERS=localhost:19092
KAFKA_EVENTS_TOPIC=events
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=aiobs
CLICKHOUSE_USER=aiobs
CLICKHOUSE_PASSWORD=aiobs_dev
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://aiobs:aiobs_dev@localhost:5432/aiobs

# Ingest API (all optional, these are the defaults)
PORT=3001
KAFKA_PARTITIONS=6
RATE_LIMIT_EVENTS_PER_SEC=500
RATE_LIMIT_BURST=5000
KEY_CACHE_TTL_MS=60000
LOG_LEVEL=info

# Host ports for Docker. Change these if another program already uses 5432 or 6379,
# and keep DATABASE_URL / REDIS_URL in step (for example POSTGRES_PORT=5433 and :5433 in the URL).
POSTGRES_PORT=5432
REDIS_PORT=6379

# Raise these if Redpanda is slow to answer on your machine
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=15000
